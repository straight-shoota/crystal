require "spec"
require "crystal/compiler_rt/shift"
require "./spec_helper"

# Ported from https://github.com/llvm/llvm-project/blob/ce59ccd04023cab3a837da14079ca2dcbfebb70c/compiler-rt/test/builtins/Unit/ashlti3_test.c

it ".__ashlti3" do
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 0).should eq 0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 1).should eq 0xFDB97530ECA8642BFDB97530ECA8642A_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 2).should eq 0xFB72EA61D950C857FB72EA61D950C854_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 3).should eq 0xF6E5D4C3B2A190AFF6E5D4C3B2A190A8_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 4).should eq 0xEDCBA9876543215FEDCBA98765432150_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 28).should eq 0x876543215FEDCBA98765432150000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 29).should eq 0x0ECA8642BFDB97530ECA8642A0000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 30).should eq 0x1D950C857FB72EA61D950C8540000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 31).should eq 0x3B2A190AFF6E5D4C3B2A190A80000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 32).should eq 0x76543215FEDCBA987654321500000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 33).should eq 0xECA8642BFDB97530ECA8642A00000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 34).should eq 0xD950C857FB72EA61D950C85400000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 35).should eq 0xB2A190AFF6E5D4C3B2A190A800000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 36).should eq 0x6543215FEDCBA9876543215000000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 60).should eq 0x5FEDCBA9876543215000000000000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 61).should eq 0xBFDB97530ECA8642A000000000000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 62).should eq 0x7FB72EA61D950C854000000000000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 63).should eq 0xFF6E5D4C3B2A190A8000000000000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 64).should eq 0xFEDCBA98765432150000000000000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 65).should eq 0xFDB97530ECA8642A0000000000000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 66).should eq 0xFB72EA61D950C8540000000000000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 67).should eq 0xF6E5D4C3B2A190A80000000000000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 68).should eq 0xEDCBA987654321500000000000000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 92).should eq 0x87654321500000000000000000000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 93).should eq 0x0ECA8642A00000000000000000000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 94).should eq 0x1D950C85400000000000000000000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 95).should eq 0x3B2A190A800000000000000000000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 96).should eq 0x76543215000000000000000000000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 97).should eq 0xECA8642A000000000000000000000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 98).should eq 0xD950C854000000000000000000000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 99).should eq 0xB2A190A8000000000000000000000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 100).should eq 0x65432150000000000000000000000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 124).should eq 0x50000000000000000000000000000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 125).should eq 0xA0000000000000000000000000000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 126).should eq 0x40000000000000000000000000000000_u128.unsafe_as(Int128)
  __ashlti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 127).should eq 0x80000000000000000000000000000000_u128.unsafe_as(Int128)
end
