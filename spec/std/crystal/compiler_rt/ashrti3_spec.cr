require "spec"
require "crystal/compiler_rt/shift"
require "./spec_helper"

# Ported from https://github.com/llvm/llvm-project/blob/ce59ccd04023cab3a837da14079ca2dcbfebb70c/compiler-rt/test/builtins/Unit/ashrti3_test.c

it ".__ashrti3" do
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 0).should eq 0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 1).should eq 0xFF6E5D4C3B2A190AFF6E5D4C3B2A190A_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 2).should eq 0xFFB72EA61D950C857FB72EA61D950C85_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 3).should eq 0xFFDB97530ECA8642BFDB97530ECA8642_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 4).should eq 0xFFEDCBA9876543215FEDCBA987654321_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 28).should eq 0xFFFFFFFFEDCBA9876543215FEDCBA987_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 29).should eq 0xFFFFFFFFF6E5D4C3B2A190AFF6E5D4C3_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 30).should eq 0xFFFFFFFFFB72EA61D950C857FB72EA61_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 31).should eq 0xFFFFFFFFFDB97530ECA8642BFDB97530_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 32).should eq 0xFFFFFFFFFEDCBA9876543215FEDCBA98_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 33).should eq 0xFFFFFFFFFF6E5D4C3B2A190AFF6E5D4C_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 34).should eq 0xFFFFFFFFFFB72EA61D950C857FB72EA6_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 35).should eq 0xFFFFFFFFFFDB97530ECA8642BFDB9753_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 36).should eq 0xFFFFFFFFFFEDCBA9876543215FEDCBA9_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 60).should eq 0xFFFFFFFFFFFFFFFFEDCBA9876543215F_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 61).should eq 0xFFFFFFFFFFFFFFFFF6E5D4C3B2A190AF_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 62).should eq 0xFFFFFFFFFFFFFFFFFB72EA61D950C857_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 63).should eq 0xFFFFFFFFFFFFFFFFFDB97530ECA8642B_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 64).should eq 0xFFFFFFFFFFFFFFFFFEDCBA9876543215_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 65).should eq 0xFFFFFFFFFFFFFFFFFF6E5D4C3B2A190A_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 66).should eq 0xFFFFFFFFFFFFFFFFFFB72EA61D950C85_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 67).should eq 0xFFFFFFFFFFFFFFFFFFDB97530ECA8642_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 68).should eq 0xFFFFFFFFFFFFFFFFFFEDCBA987654321_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 92).should eq 0xFFFFFFFFFFFFFFFFFFFFFFFFEDCBA987_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 93).should eq 0xFFFFFFFFFFFFFFFFFFFFFFFFF6E5D4C3_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 94).should eq 0xFFFFFFFFFFFFFFFFFFFFFFFFFB72EA61_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 95).should eq 0xFFFFFFFFFFFFFFFFFFFFFFFFFDB97530_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 96).should eq 0xFFFFFFFFFFFFFFFFFFFFFFFFFEDCBA98_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 97).should eq 0xFFFFFFFFFFFFFFFFFFFFFFFFFF6E5D4C_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 98).should eq 0xFFFFFFFFFFFFFFFFFFFFFFFFFFB72EA6_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 99).should eq 0xFFFFFFFFFFFFFFFFFFFFFFFFFFDB9753_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 100).should eq 0xFFFFFFFFFFFFFFFFFFFFFFFFFFEDCBA9_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 124).should eq 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 125).should eq 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 126).should eq 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF_u128.unsafe_as(Int128)
  __ashrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 127).should eq 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF_u128.unsafe_as(Int128)
end
