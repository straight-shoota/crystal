require "spec"
require "crystal/compiler_rt/shift"
require "./spec_helper"

# Ported from https://github.com/llvm/llvm-project/blob/ce59ccd04023cab3a837da14079ca2dcbfebb70c/compiler-rt/test/builtins/Unit/lshrti3_test.c

it ".__lshrti3" do
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 0).should eq 0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128)
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 1).should eq 0x7F6E5D4C3B2A190AFF6E5D4C3B2A190A_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 2).should eq 0x3FB72EA61D950C857FB72EA61D950C85_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 3).should eq 0x1FDB97530ECA8642BFDB97530ECA8642_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 4).should eq 0x0FEDCBA9876543215FEDCBA987654321_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 28).should eq 0x0000000FEDCBA9876543215FEDCBA987_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 29).should eq 0x00000007F6E5D4C3B2A190AFF6E5D4C3_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 30).should eq 0x00000003FB72EA61D950C857FB72EA61_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 31).should eq 0x00000001FDB97530ECA8642BFDB97530_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 32).should eq 0x00000000FEDCBA9876543215FEDCBA98_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 33).should eq 0x000000007F6E5D4C3B2A190AFF6E5D4C_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 34).should eq 0x000000003FB72EA61D950C857FB72EA6_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 35).should eq 0x000000001FDB97530ECA8642BFDB9753_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 36).should eq 0x000000000FEDCBA9876543215FEDCBA9_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 60).should eq 0x000000000000000FEDCBA9876543215F_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 61).should eq 0x0000000000000007F6E5D4C3B2A190AF_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 62).should eq 0x0000000000000003FB72EA61D950C857_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 63).should eq 0x0000000000000001FDB97530ECA8642B_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 64).should eq 0x0000000000000000FEDCBA9876543215_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 65).should eq 0x00000000000000007F6E5D4C3B2A190A_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 66).should eq 0x00000000000000003FB72EA61D950C85_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 67).should eq 0x00000000000000001FDB97530ECA8642_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 68).should eq 0x00000000000000000FEDCBA987654321_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 92).should eq 0x00000000000000000000000FEDCBA987_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 93).should eq 0x000000000000000000000007F6E5D4C3_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 94).should eq 0x000000000000000000000003FB72EA61_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 95).should eq 0x000000000000000000000001FDB97530_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 96).should eq 0x000000000000000000000000FEDCBA98_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 97).should eq 0x0000000000000000000000007F6E5D4C_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 98).should eq 0x0000000000000000000000003FB72EA6_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 99).should eq 0x0000000000000000000000001FDB9753_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 100).should eq 0x0000000000000000000000000FEDCBA9_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 124).should eq 0x0000000000000000000000000000000F_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 125).should eq 0x00000000000000000000000000000007_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 126).should eq 0x00000000000000000000000000000003_i128
  __lshrti3(0xFEDCBA9876543215FEDCBA9876543215_u128.unsafe_as(Int128), 127).should eq 0x00000000000000000000000000000001_i128
end
